{
  "name": "bstock-command",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pallet-reseller buying terminal for B-Stock: auction tracking, landed-cost analytics, and guarded live bidding.",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "bstock-command": "./bin/bstock-command.js"
  },
  "scripts": {
    "dev": "node apps/server/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "npm run build:web && npm run build:types",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock": "node mock/bstock-mock.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "sync": "node apps/server/src/main.ts --sync",
    "sync:static": "node scripts/sync-static.mjs",
    "ci:crawl": "node scripts/ci-backend.mjs",
    "ci:bid": "node scripts/ci-bid-dispatch.mjs",
    "firebase:status": "node apps/server/src/main.ts --firebase-status",
    "firebase:sync": "node apps/server/src/main.ts --firebase-sync",
    "firebase:pull": "node apps/server/src/main.ts --firebase-pull"
  },
  "dependencies": {
    "@fastify/aws-lambda": "^6.4.2",
    "@fastify/compress": "^9.3.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.1",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
